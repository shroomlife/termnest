<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TermNest.App.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:web="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Background="#0c0c0c"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <web:WebView2 x:Name="WebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <Grid x:Name="StatusOverlay"
              Background="#0c0c0c"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Padding="24"
              IsHitTestVisible="False">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        MaxWidth="720">
                <ProgressRing x:Name="StatusRing"
                              IsActive="True"
                              IsIndeterminate="True"
                              Width="28" Height="28"
                              HorizontalAlignment="Left"
                              Foreground="#3b8eea" />
                <TextBlock x:Name="StatusTitle"
                           Text="Connecting"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#ffffff"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusDetail"
                           Text="Establishing SSH session…"
                           FontSize="12"
                           Foreground="#9c9c9c"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           TextAlignment="Left" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
