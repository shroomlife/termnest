<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TermNest.App.Shell.ShellLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:TermNest.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomStripRow" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideRailColumn" Width="320" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <controls:SessionsPanel x:Name="SessionsPanelControl"
                                    SessionInvoked="OnSessionInvoked"
                                    StatusMessage="OnSessionsPanelStatusMessage" />
        </Border>

        <!-- Drag handle for the side rail. Pointer-based manipulation lives in
             the code-behind because CommunityToolkit's GridSplitter has not
             been pinned to a WinAppSDK 1.8 / net10 build yet. The handle is
             6px wide; the inner 1px rectangle paints the divider line, the
             surrounding transparent surface enlarges the hit-test target. -->
        <controls:SplitterHandle x:Name="SideRailSplitter"
                                 Grid.Row="0" Grid.Column="1"
                                 Width="6"
                                 Background="Transparent"
                                 ManipulationMode="TranslateX"
                                 PointerPressed="OnSideRailSplitterPointerPressed"
                                 PointerMoved="OnSideRailSplitterPointerMoved"
                                 PointerReleased="OnSideRailSplitterPointerReleased"
                                 PointerCaptureLost="OnSideRailSplitterPointerReleased">
            <Rectangle Width="1"
                       HorizontalAlignment="Left"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </controls:SplitterHandle>

        <controls:SessionTabsControl x:Name="SessionTabs"
                                     Grid.Row="0"
                                     Grid.Column="2"
                                     StatusMessage="OnTabsStatusMessage" />

        <Border x:Name="BottomStrip"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="Visible">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Click="OnSettingsClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
